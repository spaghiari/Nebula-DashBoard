# ─────────────────────────────────────────────────────────────────
# Atelier — fichiers personnels à ne JAMAIS committer
# ─────────────────────────────────────────────────────────────────

# Secrets
.env.local
.env.local.bak.*
.env.local.enc
*.env

# Données utilisateur (registre, workspaces enregistrés, sessions)
/dashboard/data/workspaces.json
/mcp/registry.json
/mcp/registry.json.bak

# Workspaces réels (chaque utilisateur a les siens)
/workspaces/*
!/workspaces/.gitkeep

# Scripts de lancement par workspace (générés à la création)
/scripts/launch-*.bat
!/scripts/launch-TEMPLATE.bat

# Sauvegardes & logs
/backups/
/logs/

# Journal personnel
/memory/journal.md

# Recettes MCP locales (perso, propriétaires) — uniquement chez l'utilisateur
/dashboard/data/mcp_recipes.local.json

# UI state runtime (thème, onboarding…)
/dashboard/data/ui_state.json

# État de sync MCP runtime (hash du dernier .mcp.json généré par workspace,
# pour détecter les éditions manuelles du fichier)
/dashboard/data/mcp_sync_state.json

# Sessions Claude lancées depuis Nebula (PID + date de création, runtime)
/dashboard/data/active_sessions.json
/dashboard/data/*.corrupt-*

# Bibliotheque de skills locale (runtime, contenu personnel)
/dashboard/data/skills-library/

# Reflexive — DB locale, propositions, log d'erreurs hooks
/dashboard/data/reflexive.db
/dashboard/data/reflexive.db-wal
/dashboard/data/reflexive.db-shm
/dashboard/data/reflexive_hook_errors.log
/dashboard/data/proposals/

# Outils de dev local (preflight, checklist)
/dashboard/tools/

# Caches
__pycache__/
*.pyc
*.pyo
*.bak

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Configuration IDE de Claude Code (par projet)
.claude/settings.local.json
