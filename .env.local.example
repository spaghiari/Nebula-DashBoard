# Fichier de secrets pour le dashboard Claude Workspace.
#
# Copie ce fichier en .env.local (même dossier) puis remplis tes clés.
# Les valeurs sont substituées dans les .mcp.json générés : toute
# référence ${NOM_DE_VARIABLE} dans command/args/env/url d'un MCP est
# remplacée par la valeur ici.
#
# NE PAS COMMITTER .env.local.
# Format : KEY=valeur (guillemets optionnels)

# ---------- Exemples ----------
# HA_TOKEN=eyJhbGciOi....
# BRAVE_API_KEY=BSA_xxxxxxxxxxxxxxxx
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ---------- n8n ----------
# N8N_URL=https://n8n.example.lan
# N8N_TOKEN=

# ---------- Wiki.js ----------
# WIKIJS_API_URL=https://wiki.example.com
# WIKIJS_TOKEN=

# ---------- OPNsense ----------
# OPNSENSE_URL=https://opnsense.example.lan:4443
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=
# OPNSENSE_VERIFY_SSL=false

# ---------- Binary Ninja ----------
# BINJA_MCP_URL=http://127.0.0.1:42069
# BINJA_MCP_KEY=
# BINJA_MCP_SCRIPT=

# ---------- x64dbg ----------
# X64DBG_PYTHON=
# X64DBG_SCRIPT=
