{
  "_comment_permissions": "Permissions allow/deny pour le projet. À étendre/restreindre selon les besoins du projet. Les commandes de mutation système (systemctl, /etc/, etc.) doivent être en deny par défaut et ajoutées en allow explicitement si nécessaire.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push origin:*)",
      "Bash(wc -l:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git checkout main)",
      "Bash(rm -rf:*)"
    ]
  },
  "_comment_hooks": "Hooks fournis par le template. À étendre avec les hooks projet-spécifiques (lint syntaxique selon stack, etc.).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-local-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/em-dash-precommit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/improvements-validate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/co-authored-by-precommit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind-check-all.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/hooks/statusline.sh"
  }
}
