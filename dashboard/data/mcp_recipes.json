      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {},
      "params": [],
      "docs_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/memory"
    },
    {
