    {
      "id": "postgres",
      "name": "PostgreSQL",
      "emoji": "🐘",
      "description": "Connexion lecture seule à une base PostgreSQL. Le LLM peut interroger les schémas et exécuter des SELECT.",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${CONNECTION}"],
      "env": {},
      "params": [
        {
          "key": "CONNECTION",
          "label": "Chaîne de connexion PostgreSQL",
          "placeholder": "postgresql://user:pass@localhost:5432/dbname",
          "required": true,
          "secret": true
        }
      ],
      "docs_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/postgres"
