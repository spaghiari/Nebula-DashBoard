    {
      "id": "slack",
      "name": "Slack",
      "emoji": "💬",
      "description": "Lecture des canaux, messages, threads. Envoi de messages si le bot a les permissions.",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${BOT_TOKEN}",
        "SLACK_TEAM_ID": "${TEAM_ID}"
      },
      "params": [
        {
          "key": "BOT_TOKEN",
          "label": "Bot User OAuth Token",
          "placeholder": "xoxb-xxxxxxxxxxxxxx",
          "required": true,
          "secret": true
        },
        {
          "key": "TEAM_ID",
          "label": "Team ID (workspace Slack)",
          "placeholder": "T01234ABCDE",
          "required": true,
          "secret": false
        }
      ],
      "docs_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/slack"
    }
  ]
